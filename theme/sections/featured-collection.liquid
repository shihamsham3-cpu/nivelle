{%- liquid
  assign products = section.settings.collection.products
  if products == blank or products.size == 0
    assign products = collections.all.products
  endif
-%}
<section class="section" id="collection">
  <div class="container">
    <div class="section-head-row" data-reveal>
      <div class="section-head" style="margin-bottom:0">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}<p class="lede">{{ section.settings.body }}</p>{%- endif -%}
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="link-underline">
        Shop All
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="product-grid" data-stagger="90">
      {%- for product in products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p class="text-muted">No products yet.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "count", "label": "Products shown", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything We Make" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Each design in its own set of colourways. Prices and stock are live." }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
