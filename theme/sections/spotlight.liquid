{%- assign product = section.settings.product -%}
{%- if product == blank -%}{%- assign product = collections.all.products.last -%}{%- endif -%}

<section class="spotlight">
  <div class="container">
    <div class="spotlight-grid" data-reveal>
      <div class="spotlight-media">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 900 }}"
               srcset="{{ product.featured_image | image_url: width: 440 }} 440w, {{ product.featured_image | image_url: width: 660 }} 660w, {{ product.featured_image | image_url: width: 900 }} 900w"
               sizes="(min-width: 900px) 44vw, 92vw"
               width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
               alt="{{ product.title | escape }}" loading="lazy" decoding="async" data-parallax="0.04">
        {%- endif -%}
      </div>
      <div class="spotlight-copy">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | default: product.title }}</h2>
        {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}

        {%- comment -%} Stock facts are read from the product, never typed in. {%- endcomment -%}
        {%- assign total = product.variants | size -%}
        {%- assign available = 0 -%}
        {%- for variant in product.variants -%}
          {%- if variant.available -%}{%- assign available = available | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        {%- assign gone = total | minus: available -%}

        <ul class="spotlight-list">
          {%- if product.compare_at_price > product.price -%}
            {%- assign saving = product.compare_at_price | minus: product.price -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {{ saving | money }} off while stock lasts
            </li>
          {%- endif -%}
          {%- if gone > 0 -%}
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {{ gone }} of {{ total }} colourways sold out
            </li>
          {%- endif -%}
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Ships from stock with 30-day returns
          </li>
        </ul>

        {%- if gone > 0 -%}
          {%- assign pct = gone | times: 100 | divided_by: total -%}
          <div class="edition-meter" data-meter="{{ pct }}">
            <div class="labels">
              <span>Colourways</span>
              <span><strong>{{ gone }} of {{ total }}</strong> sold out</span>
            </div>
            <div class="bar" role="img" aria-label="{{ gone }} of the {{ total }} colourways have sold out">
              <span class="fill"></span>
            </div>
          </div>
        {%- endif -%}

        <a href="{{ product.url }}" class="btn btn-primary">{{ section.settings.cta_label | default: 'See it' }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spotlight",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Down to the last colourway" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "See it" }
  ],
  "presets": [{ "name": "Spotlight" }]
}
{% endschema %}
