{%- liquid
  assign products = section.settings.collection.products
  if products == blank or products.size == 0
    assign products = collections.all.products
  endif
-%}

<section class="hero hero-editorial">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-content">
      <div class="hero-stack">
        {%- comment -%}
          Counting the catalogue by hand went stale every time a product was
          added. Count it live, and fall back to the typed eyebrow only when
          the collections are missing.
        {%- endcomment -%}
        {%- assign bag_count = collections.bags.all_products_count -%}
        {%- assign charm_count = collections.charms.all_products_count -%}
        {%- if bag_count > 0 and charm_count > 0 -%}
          <span class="eyebrow">
            {{ bag_count }} {% if bag_count == 1 %}bag{% else %}bags{% endif %}
            &middot;
            {{ charm_count }} {% if charm_count == 1 %}charm{% else %}charms{% endif %}
          </span>
        {%- elsif section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="display-1 hero-editorial-heading">{{ section.settings.heading }}</h1>

        {%- comment -%}
          The photo is a merchant-supplied cutout, not a product image, so it
          sits outside Shopify's file CDN — a plain theme asset like the
          webfonts. Deliberately overlapping: a negative margin on the
          heading pulls this figure up underneath its lower line.
        {%- endcomment -%}
        <figure class="hero-photo" aria-hidden="true">
          <img src="{{ 'hero-marlowe-black-white.png' | asset_url }}"
               width="1080" height="1040" alt="" loading="eager" fetchpriority="high">
          <span class="hero-charms-left">
            <img class="charm-alpaca" src="{{ 'charm-clover-alpaca.png' | asset_url }}" width="368" height="529" alt="" loading="eager">
            <img class="charm-bear" src="{{ 'charm-bramble-bear.png' | asset_url }}" width="635" height="774" alt="" loading="eager">
          </span>
          <span class="hero-charms">
            <img class="charm-purple" src="{{ 'charm-scrapper-purple.png' | asset_url }}" width="608" height="775" alt="" loading="eager">
            <img class="charm-taupe" src="{{ 'charm-scrapper-taupe.png' | asset_url }}" width="561" height="864" alt="" loading="eager">
          </span>
        </figure>
      </div>

      {%- if section.settings.body != blank -%}
        <p class="lede">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.show_proof -%}
        {%- assign swatch_count = 0 -%}
        <div class="hero-proof">
          <span class="avatar-row" aria-hidden="true">
            {%- for product in products limit: 3 -%}
              {%- for option in product.options_with_values -%}
                {%- assign lowered = option.name | downcase -%}
                {%- if lowered contains 'colour' or lowered contains 'color' -%}
                  {%- for value in option.values -%}
                    {%- if swatch_count < 5 -%}
                      <span class="swatch-chip" style="background: {% render 'swatch-color', name: value %}"></span>
                      {%- assign swatch_count = swatch_count | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </span>
          <span>{{ section.settings.proof_text }}</span>
        </div>
      {%- endif -%}

      <div class="hero-actions">
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn-primary">
          {{ section.settings.cta_label }}
        </a>
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_url | default: routes.all_products_collection_url }}" class="btn btn-outline-light">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
        <svg class="hero-charm-tag" width="72" height="40" viewBox="0 0 72 40" aria-hidden="true">
          <path d="M2 5 L56 5 L70 20 L56 35 L2 35 Z" fill="#211d19" stroke="#8a5306" stroke-width="1"/>
          <path d="M7 9.5 L53.5 9.5 L64 20 L53.5 30.5 L7 30.5 Z" fill="none" stroke="#dcb15a" stroke-width="1" stroke-dasharray="2.2 3.2" opacity="0.85"/>
          <circle cx="18" cy="20" r="7.5" fill="none" stroke="#dcb15a" stroke-width="1" opacity="0.9"/>
          <text x="18" y="23.5" font-family="'Cormorant', serif" font-style="italic" font-size="11" fill="#dcb15a" text-anchor="middle">N</text>
        </svg>
      </div>

      <ul class="hero-meta">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <span class="scroll-cue" aria-hidden="true"><span class="line"></span>Scroll</span>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Products used for the colourway row", "info": "Leave empty to use all products." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Only used if the Bags and Charms collections are unavailable — otherwise counted live.", "default": "Bags and charms, made to be carried" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Faux leather.<br><em>Real intention.</em>" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Structured, considered, $49.99 to $89.99. We'd rather you use it every day than save it for one." },
    { "type": "checkbox", "id": "show_proof", "label": "Show colourway row", "default": true },
    { "type": "text", "id": "proof_text", "label": "Colourway line", "default": "Every colourway in stock now" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop All Bags" },
    { "type": "url", "id": "cta_url", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Trust point",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "30-day returns" }]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "point", "settings": { "text": "30-day returns" } },
        { "type": "point", "settings": { "text": "Ships worldwide" } },
        { "type": "point", "settings": { "text": "Secure Shopify checkout" } }
      ]
    }
  ]
}
{% endschema %}
