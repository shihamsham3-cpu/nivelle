<header class="page-header">
  <div class="container">
    <span class="eyebrow">Bag</span>
    <h1>{{ 'cart.general.title' | t }}</h1>
  </div>
</header>

<section class="section">
  <div class="container">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty" style="text-align:center">
        <p class="lede">{{ 'cart.general.empty' | t }}</p>
        <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <ul class="cart-lines cart-lines-page">
          {%- for line in cart.items -%}
            <li class="cart-line">
              <a class="cart-line-media" href="{{ line.url }}">
                {%- if line.image -%}{{ line.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: line.title }}{%- endif -%}
              </a>
              <div class="cart-line-info">
                <a class="cart-line-title" href="{{ line.url }}">{{ line.product.title }}</a>
                {%- unless line.variant.title contains 'Default' -%}
                  <p class="cart-line-variant">{{ line.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-line-price">{{ line.final_line_price | money }}</p>
                <div class="qty-stepper cart-qty">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ line.quantity | minus: 1 }}" aria-label="Decrease quantity">&minus;</a>
                  <span class="cart-qty-value">{{ line.quantity }}</span>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ line.quantity | plus: 1 }}" aria-label="Increase quantity">+</a>
                </div>
              </div>
              <a class="cart-remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" aria-label="{{ 'cart.general.remove' | t }} {{ line.product.title | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-foot cart-foot-page">
          <div class="cart-subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="form-note">{{ 'cart.general.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="btn btn-primary btn-block">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
