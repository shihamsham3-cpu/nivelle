<div class="cart-drawer" data-cart-drawer data-open="false" aria-live="polite">
  <div class="drawer-backdrop" data-cart-backdrop></div>
  <div class="cart-panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <div class="drawer-head">
      <h2 class="cart-title">{{ 'cart.general.title' | t }}
        <span class="cart-count-inline">({{ cart.item_count }})</span>
      </h2>
      <button type="button" class="icon-btn" data-cart-close aria-label="{{ 'general.accessibility.close' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a class="btn btn-primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- else -%}
      <ul class="cart-lines">
        {%- for line in cart.items -%}
          <li class="cart-line">
            <a class="cart-line-media" href="{{ line.url }}">
              {%- if line.image -%}
                {{ line.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: line.title }}
              {%- endif -%}
            </a>
            <div class="cart-line-info">
              <a class="cart-line-title" href="{{ line.url }}">{{ line.product.title }}</a>
              {%- unless line.variant.title contains 'Default' -%}
                <p class="cart-line-variant">{{ line.variant.title }}</p>
              {%- endunless -%}
              <p class="cart-line-price">{{ line.final_line_price | money }}</p>

              <div class="qty-stepper cart-qty">
                <button type="button" data-cart-change="{{ line.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="Decrease quantity">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <span class="cart-qty-value">{{ line.quantity }}</span>
                <button type="button" data-cart-change="{{ line.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="Increase quantity">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              </div>
            </div>
            <button type="button" class="cart-remove" data-cart-change="0" data-line="{{ forloop.index }}" aria-label="{{ 'cart.general.remove' | t }} {{ line.product.title | escape }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
            </button>
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-foot">
        <div class="cart-subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="form-note">{{ 'cart.general.taxes_note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn-primary btn-block">{{ 'cart.general.checkout' | t }}</button>
        </form>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Cart drawer" }
{% endschema %}
