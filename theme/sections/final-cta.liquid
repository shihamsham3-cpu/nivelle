<section class="newsletter section" data-sticky-stop>
  <div class="container">
    <div class="newsletter-inner" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}<p class="lede text-center">{{ section.settings.body }}</p>{%- endif -%}
      <div class="hero-actions" style="justify-content:center">
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn-dark">
          {{ section.settings.cta_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Closing CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready when you are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick A Colour, We'll Ship It" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "30-day returns on every order. Sold-out colourways are marked before you add anything to your bag." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop All Bags" },
    { "type": "url", "id": "cta_url", "label": "Link" }
  ],
  "presets": [{ "name": "Closing CTA" }]
}
{% endschema %}
