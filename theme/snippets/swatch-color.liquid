{%- comment -%}
  Maps an option value to a swatch colour. Anything not listed falls back to a
  neutral chip rather than showing a confidently wrong colour.
  Accepts: name
{%- endcomment -%}
{%- assign key = name | downcase | strip -%}
{%- case key -%}
  {%- when 'white' -%}#F2EFE9
  {%- when 'black' -%}#1c1917
  {%- when 'gray', 'grey' -%}#8B8985
  {%- when 'brown' -%}#6B4226
  {%- when 'tan' -%}#C2A075
  {%- when 'cognac' -%}#A9764C
  {%- when 'cream', 'ivory' -%}#E4DAC6
  {%- when 'olive' -%}#6B7043
  {%- when 'light blue', 'sky blue', 'baby blue' -%}#A8C6DB
  {%- when 'blue' -%}#3E6690
  {%- when 'navy' -%}#22304A
  {%- when 'burgundy', 'claret', 'wine' -%}#6B2737
  {%- when 'red' -%}#9B2C2C
  {%- when 'rose pink', 'rose' -%}#D9A0A8
  {%- when 'pink' -%}#E2A9BC
  {%- when 'purple' -%}#6B4E9B
  {%- when 'dark coffee' -%}#3E2A20
  {%- when 'green', 'emerald' -%}#2F4C3B
  {%- when 'beige', 'sand' -%}#C7B299
  {%- when 'gold' -%}#C9A227
  {%- when 'silver' -%}#BFC3C7
  {%- else -%}#CFC7BA
{%- endcase -%}
